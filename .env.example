# Local and Dokploy. Change every secret before this machine is reachable by anyone else.

DATABASE_URL=postgres://socialhub:socialhub@localhost:5434/socialhub
REDIS_URL=redis://localhost:6380
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=owner@socialhub.local
ADMIN_PASSWORD=change-me
ADMIN_NAME=Owner

# mock: every connect and publish is simulated.
# live: only accounts explicitly connected as live will attempt a real provider,
# and those providers refuse until credentials exist. They never report success.
INTEGRATIONS_MODE=mock

SEED=true
STORAGE_DIR=./storage
PORT=3000
WEB_ORIGIN=http://localhost:5173
